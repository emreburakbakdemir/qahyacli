version: 1

providers:
    local:
        type: file
        path: ./secrets.yaml

defaults:
    env:
        APP_NAME: qahya-demo
        LOG_LEVEL: info
        MULTILINE: "line1\nline2"   # a real newline inside the value
        TRICKY: 'it''s $(whoami) "quoted" $HOME'

profiles:
    staging:
        env:
            APP_ENV: staging
            DB_HOST: db.staging.internal
            VERSION: 1.10
            COUNTRY: NO
            DB_PASS:
                secret: local:db/staging#password
            API_TOKEN: { secret: local:api/staging#token }

    prod:
        env:
            APP_ENV: prod
            DB_HOST: db.prod.internal
            LOG_LEVEL: warn     # overrides defaults
            DB_PASS:
                secret: local:db/prod#password